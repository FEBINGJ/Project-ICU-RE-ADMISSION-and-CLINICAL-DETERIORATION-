# Template for your private settings. Do NOT put your real password in this file.
#
#   Windows:   copy .env.example .env
#   Mac/Linux: cp .env.example .env
#
# Then open .env (the copy) and put your own values in. .env is ignored by git, so it is never uploaded.

# ---- Database (Phase 7 Part B) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=icu_risk
DB_USER=postgres
DB_PASSWORD=change-me 


# Using the Docker database from docker-compose.yml instead of the PostgreSQL installed on your laptop?
# Set DB_PORT=5433 (Docker uses 5433 so it cannot clash with the native PostgreSQL on 5432).

# Optional: ONE full address that replaces the five DB_* lines above. Leave it commented out unless you need it:
# if this line is active, DB_HOST, DB_PORT, DB_NAME, DB_USER and DB_PASSWORD are ignored.
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/icu_risk

# ---- Login (used from Phase 7 Part D) ----
SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Paths used by the ML code ----
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODEL_DIR=models
